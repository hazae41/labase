{
  "type": "module",
  "name": "@hazae41/labase",
  "version": "1.0.34",
  "description": "The Tailwind framework for monochrome apps",
  "repository": "github:hazae41/labase",
  "author": "hazae41",
  "license": "MIT",
  "scripts": {
    "examine": "deno lint ./src && deno check ./src && deno test ./src",
    "prepack:css": "cp ./src/mod.css ./out && cp -R ./src/css ./out/css",
    "prepack": "rm -rf ./out && tsc && tscousin && npm run prepack:css"
  },
  "files": [
    "./out"
  ],
  "exports": {
    ".": {
      "types": "./out/mod.d.ts",
      "import": "./out/mod.js"
    }
  },
  "keywords": [
    "monochrome",
    "css",
    "framework",
    "tailwind",
    "design",
    "style"
  ],
  "devDependencies": {
    "@hazae41/tscousin": "^1.0.28",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "tailwindcss": ">=4.0.0"
  }
}